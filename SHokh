local oShadow,oSoft,oBright,oAmb,oOut,oFog
local function applyNoShadow(on)
    if on then
        oShadow=Lighting.GlobalShadows; oSoft=Lighting.ShadowSoftness
        Lighting.GlobalShadows=false; Lighting.ShadowSoftness=1
    else
        if oShadow~=nil then Lighting.GlobalShadows=oShadow end
        if oSoft then Lighting.ShadowSoftness=oSoft end
    end
end
local function applyFullBright(on)
    if on then
        oBright=Lighting.Brightness; oAmb=Lighting.Ambient
        oOut=Lighting.OutdoorAmbient; oFog=Lighting.FogEnd
        Lighting.Brightness=2; Lighting.Ambient=Color3.new(1,1,1)
        Lighting.OutdoorAmbient=Color3.new(1,1,1); Lighting.FogEnd=1e5
    else
        if oBright then Lighting.Brightness=oBright end
        if oAmb then Lighting.Ambient=oAmb end
        if oOut then Lighting.OutdoorAmbient=oOut end
        if oFog then Lighting.FogEnd=oFog end
    end
end

-- Fast Mode — faqat bino/textura, gun/car/player HIMOYALANADI
local function isProtected(inst)
    local cur=inst
    for _=1,8 do
        if not cur or cur==workspace then break end
        if cur:IsA("Tool") then return true end
        if cur:IsA("Model") then
            if cur:FindFirstChildOfClass("Humanoid") then return true end
            if cur:FindFirstChildOfClass("VehicleSeat") then return true end
            if cur:FindFirstChild("DriveSeat") then return true end
        end
        cur=cur.Parent
    end
    return false
end
local fmOrig={}
local fmConn=nil
local function stripTexture(inst)
    if isProtected(inst) then return end
    if inst:IsA("Decal") or inst:IsA("Texture") then
        if fmOrig[inst]==nil then fmOrig[inst]=inst.Transparency end
        pcall(function() inst.Transparency=1 end)
    elseif inst:IsA("MeshPart") then
        if inst.TextureID~="" and fmOrig[inst]==nil then
            fmOrig[inst]=inst.TextureID
            pcall(function() inst.TextureID="" end)
        end
    end
end
local function applyFastMode(on)
    if fmConn then fmConn:Disconnect(); fmConn=nil end
    if on then
        for _,inst in ipairs(workspace:GetDescendants()) do pcall(stripTexture,inst) end
        fmConn=workspace.DescendantAdded:Connect(function(inst)
            if cfg.fastMode then task.defer(stripTexture,inst) end
        end)
    else
        for inst,val in pairs(fmOrig) do
            if inst and inst.Parent then
                pcall(function()
                    if inst:IsA("MeshPart") then inst.TextureID=val
                    else inst.Transparency=val end
                end)
            end
        end
        fmOrig={}
    end
end

