    origWalk=nil; origJump=nil; task.wait(0.5)
    if cfg.speedHack then applySpeed(true) end
    if cfg.jumpHack then applyJump(true) end
    if cfg.noclip then applyNoclip(true) end
    applyPlayerFov(cfg.playerFov)
end)

local function applyAll()
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local c=p.Character; if not c then continue end
        if cfg.esp then addHL(p,c) else removeHL(c) end
    end
    applyNoShadow(cfg.noShadow); applyFullBright(cfg.fullBright); applyFastMode(cfg.fastMode)
    applySpeed(cfg.speedHack); applyJump(cfg.jumpHack)
    applyNoclip(cfg.noclip); applyInfJump(cfg.infiniteJump)
    applyAntiAfk(cfg.antiAfk); applyPlayerFov(cfg.playerFov)
end

