local function clamp255(v) return math.clamp(math.floor(v+0.5),0,255) end
local function lighten(c,amt) return Color3.fromRGB(clamp255(c.R*255+amt),clamp255(c.G*255+amt),clamp255(c.B*255+amt)) end
local function darken(c,amt) return lighten(c,-amt) end
local function mix(c1,c2,t) return c1:Lerp(c2,t) end

-- Default: Midnight Blue
local function deriveTheme(accent,bg)
    return {
        bg=bg, sidebar=darken(bg,4), sideAct=lighten(bg,10),
        panel=lighten(bg,6), panelHov=lighten(bg,12),
        accent=accent, border=accent, borderDim=mix(accent,bg,0.55),
        textPri=Color3.fromRGB(228,234,245), textSec=mix(accent,Color3.fromRGB(228,234,245),0.55),
        textDim=mix(accent,bg,0.35), tOn=accent, tOff=lighten(bg,20),
        track=darken(bg,2), green=Color3.fromRGB(60,220,120), red=Color3.fromRGB(220,70,60),
    }
end

local C = deriveTheme(Color3.fromRGB(90,150,255), Color3.fromRGB(10,18,44)) -- Midnight Blue

