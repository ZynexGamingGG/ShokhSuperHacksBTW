local HL="ShokhHL"
local function espCol() return Color3.fromRGB(cfg.espR,cfg.espG,cfg.espB) end
local function getHL(c) return c:FindFirstChild(HL) end
local function addHL(p,char)
    if p==LP or getHL(char) then return end
    local h=Instance.new("Highlight"); h.Name=HL; h.Adornee=char
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.FillColor=espCol(); h.OutlineColor=Color3.new(1,1,1)
    h.FillTransparency=0.45; h.Parent=char
end
local function removeHL(char) local h=getHL(char); if h then h:Destroy() end end

-- Drawing pool: har o'yinchi uchun tracer/box/name/health
local dPool={}
local function getPool(p)
    if dPool[p] then return dPool[p] end
    local ok,pool = pcall(function()
        return {
            tracer=Drawing.new("Line"),
            box=Drawing.new("Square"),
            nameText=Drawing.new("Text"),
            hpBg=Drawing.new("Square"),
            hpFill=Drawing.new("Square"),
            hpText=Drawing.new("Text"),
        }
    end)
    if not ok then return nil end
    pool.tracer.Thickness=1.4
    pool.box.Thickness=1.4; pool.box.Filled=false
    pool.nameText.Center=true; pool.nameText.Size=14; pool.nameText.Outline=true
    pool.hpBg.Filled=true
    pool.hpFill.Filled=true
    pool.hpText.Center=true; pool.hpText.Size=12; pool.hpText.Outline=true
    dPool[p]=pool
    return pool
end
local function hideDrawing(p)
    local pool=dPool[p]; if not pool then return end
    for _,d in pairs(pool) do pcall(function() d.Visible=false end) end
end
local function removeDrawing(p)
    local pool=dPool[p]; if not pool then return end
    for _,d in pairs(pool) do pcall(function() d:Remove() end) end
    dPool[p]=nil
end
Players.PlayerRemoving:Connect(function(p)
    if p.Character then removeHL(p.Character) end
    removeDrawing(p)
end)

local function getScreenBox(char)
    local ok,cf,size = pcall(function() return char:GetBoundingBox() end)
    if not ok or not cf then return nil end
    local minX,minY,maxX,maxY = math.huge,math.huge,-math.huge,-math.huge
    local anyVisible=false
    for _,mx in ipairs({-1,1}) do
        for _,my in ipairs({-1,1}) do
            for _,mz in ipairs({-1,1}) do
                local corner = cf * CFrame.new(size.X/2*mx, size.Y/2*my, size.Z/2*mz)
                local sp,vis = Camera:WorldToViewportPoint(corner.Position)
                if vis then anyVisible=true end
                minX=math.min(minX,sp.X); maxX=math.max(maxX,sp.X)
                minY=math.min(minY,sp.Y); maxY=math.max(maxY,sp.Y)
            end
        end
    end
    if not anyVisible then return nil end
    return minX,minY,(maxX-minX),(maxY-minY)
end

