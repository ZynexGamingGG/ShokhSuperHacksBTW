-- ══════════════════════════════════════════════════════
--  BITTA ASOSIY HEARTBEAT  (FPS, ESP+Drawing, Rainbow)
-- ══════════════════════════════════════════════════════
local rainbowHue=0
local fpsTimer=0
local espTimer=0

RunService.Heartbeat:Connect(function(dt)
    -- FPS (0.5s)
    fpsTimer+=dt
    if fpsTimer>=0.5 then
        fpsTimer=0
        local fpsVal=math.floor(1/(dt+0.0001))
        if wmL then wmL.Text=("ShokhHacks  |  %s  |  FPS: %d"):format(LP.Name,fpsVal) end
    end

    -- Rainbow hue tick
    rainbowHue=(rainbowHue+dt*0.25)%1
    local rbCol = cfg.rainbow and Color3.fromHSV(rainbowHue,0.9,1) or nil
    if rbBtn then rbBtn.BackgroundColor3 = rbCol or C.red end

    -- ESP + Drawing (Box/Tracers/Name/HealthTag) — 0.05s (20fps chegarasi)
    espTimer+=dt
    if espTimer>=0.05 then
        espTimer=0
        local espC = (not cfg.rainbow) and espCol() or nil
        local anyDrawing = cfg.boxEsp or cfg.tracers or cfg.nameEsp or cfg.healthTag
        local bottomCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)

        for _,p in ipairs(Players:GetPlayers()) do
            if p==LP then continue end
            local char=p.Character
            local isTeammate = cfg.teamCheck and p.Team and LP.Team and p.Team==LP.Team

            if not char or isTeammate then
                if char then removeHL(char) end
                hideDrawing(p)
                continue
            end

            -- Highlight ESP
            if cfg.esp then addHL(p,char) else removeHL(char) end
            local h=getHL(char)
            if h then
                if rbCol then h.FillColor=rbCol
                elseif espC then h.FillColor=espC end
            end

            -- Drawing-based ESP (Box/Tracers/Name/HealthTag)
            if anyDrawing then
                local pool=getPool(p)
                if pool then
                    local hum=char:FindFirstChildOfClass("Humanoid")
                    local hrp=char:FindFirstChild("HumanoidRootPart")
                    local bx,by,bw,bh = getScreenBox(char)
                    local drawCol = rbCol or espC or Color3.fromRGB(90,150,255)

                    if bx and hum and hrp then
                        -- Box
                        if cfg.boxEsp then
                            pool.box.Position=Vector2.new(bx,by); pool.box.Size=Vector2.new(bw,bh)
                            pool.box.Color=drawCol; pool.box.Visible=true
                        else pool.box.Visible=false end

                        -- Tracer
                        if cfg.tracers then
                            pool.tracer.From=bottomCenter
                            pool.tracer.To=Vector2.new(bx+bw/2, by+bh)
                            pool.tracer.Color=drawCol; pool.tracer.Visible=true
                        else pool.tracer.Visible=false end

                        -- Name
                        if cfg.nameEsp then
                            pool.nameText.Position=Vector2.new(bx+bw/2, by-16)
                            pool.nameText.Text=p.Name; pool.nameText.Color=drawCol
                            pool.nameText.Visible=true
                        else pool.nameText.Visible=false end

                        -- Health Tag
                        if cfg.healthTag then
                            local pct=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
                            pool.hpBg.Position=Vector2.new(bx-8,by); pool.hpBg.Size=Vector2.new(4,bh)
                            pool.hpBg.Color=Color3.fromRGB(20,20,26); pool.hpBg.Visible=true
                            pool.hpFill.Position=Vector2.new(bx-8, by+bh*(1-pct))
                            pool.hpFill.Size=Vector2.new(4, math.max(bh*pct,1))
                            pool.hpFill.Color=Color3.fromRGB(math.floor(255*(1-pct)),math.floor(200*pct),60)
                            pool.hpFill.Visible=true
                            pool.hpText.Position=Vector2.new(bx-8, by-16)
                            pool.hpText.Text=math.floor(hum.Health).."/"..math.floor(hum.MaxHealth)
                            pool.hpText.Color=Color3.fromRGB(220,220,230)
                            pool.hpText.Visible=true
                        else
                            pool.hpBg.Visible=false; pool.hpFill.Visible=false; pool.hpText.Visible=false
                        end
                    else
                        hideDrawing(p)
                    end
                end
            else
                hideDrawing(p)
            end
        end
    end
end)

